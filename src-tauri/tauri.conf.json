{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoReview",
  "version": "1.4.2",
  "identifier": "local.autoreview.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../release/runtime/AutoReview-Service/": "runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerHooks": "account-cleanup.nsh",
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "compression": "zlib"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
